# provenance files beside them (build_settings.txt, his_states.txt, residue_map.json)
# are tracked because they record what was actually built.
data/md191/*/rep*/*.nc
data/md191/*/rep*/*.rst7
data/md191/*/rep*/*.out
data/md191/*/rep*/*.info
data/md191/*/rep*/*.in
data/md191/*/system.prmtop
data/md191/*/system.inpcrd
data/md191/*/system_solvated.pdb
data/md191/*/input_protein.pdb
data/md191/*/protein.pdb
data/md191/*/tleap*.log
data/md191/*/tleap.in*
data/md191/*/pdb4amber.log
data/md191/*/leap.log
data/md191/*/rep*/
data/md191/_verify/
data/papers/**/*.pdf
data/papers/**/*.xlsx
data/mmgbsa/**/*.nc
data/mmgbsa/**/*.prmtop
data/mmgbsa/**/*.rst7
data/mmgbsa/**/*.inpcrd
data/mmgbsa/**/seed*_protein.pdb
data/mmgbsa/**/reference.frc
data/mmgbsa/**/*_clean*.pdb
data/mmgbsa/**/*_renum.txt
data/mmgbsa/**/*.log
data/mmgbsa/**/*.out
data/mmgbsa_50ps/**/reference.frc
data/mmgbsa_50ps/**/*.nc
data/mmgbsa_50ps/**/*.prmtop
data/mmgbsa_50ps/**/*.rst7
data/mmgbsa_50ps/**/*.inpcrd
data/mmgbsa_50ps/**/*.pdb
data/mmgbsa_50ps/**/*.log
data/mmgbsa_50ps/**/*.out
results/homolog_cavities/homolog_cavities_partial.csv
results/homolog_cavities/raw/
results/homolog_cavities/domains/
results/homolog_cavities/ca_traces/
results/homolog_cavities/subdb*

# Explicit-solvent reference systems (README 42), ~4.5 GB. Same rule as data/md191/:
# trajectories, topologies and per-stage Amber output are regenerable from
# 80_explicit_build.sh -> 81_explicit_run.sh -> 83_explicit_mmgbsa.sh. The files that
# record what was actually built and what was measured -- build_settings.txt,
# his_states.txt, ligand.txt, seeds.txt, the MM-GBSA .dat/.csv and the cpptraj
# time series -- ARE tracked, because they are the evidence, not the bulk.
data/mmgbsa_explicit/**/*.nc
data/mmgbsa_explicit/**/*.prmtop
data/mmgbsa_explicit/**/*.inpcrd
data/mmgbsa_explicit/**/*.rst7
data/mmgbsa_explicit/**/*.mdinfo
data/mmgbsa_explicit/**/*.out
data/mmgbsa_explicit/**/*.log
data/mmgbsa_explicit/**/*.pdb
data/mmgbsa_explicit/**/*.in
data/mmgbsa_explicit/**/tleap.in.template
data/mmgbsa_explicit/**/_MMPBSA_*

# reference.frc is a ~63 MB sander artefact written into EVERY MM-GBSA run dir.
# It has now had to be un-staged three times because the rule was written
# per-directory (data/mmgbsa/, then data/mmgbsa_50ps/, then here), so each new
# data directory silently re-opened the hole. Match it GLOBALLY instead -- a rule
# that depends on remembering to extend it is not a rule.
reference.frc
**/reference.frc

# TI alchemical systems (README 43), ~10 GB. Regenerate with 85 -> 86 -> 87.
# The per-window dvdl.txt, masks.txt and merge.log ARE tracked: they are the
# measurement and the record of which atoms were perturbed.
data/ti/**/*.prmtop
data/ti/**/*.inpcrd
data/ti/**/*.rst7
data/ti/**/*.nc
data/ti/**/*.mdinfo
data/ti/**/*.out
data/ti/**/*.pdb
data/ti/**/*.in
data/ti/**/tleap.log

# ---------------------------------------------------------------------------
# GLOBAL simulation-artefact rules (added 2026-08-22).
# The four blocks above were each written per-directory (data/mmgbsa/,
# data/mmgbsa_50ps/, data/mmgbsa_explicit/, data/ti/) and every new system
# re-introduced the same failure: `git add -A` hanging on a multi-GB binary.
# The non-cognate runs then landed in data/md/*/pose*/ rather than */rep*/, so
# the data/md/ block missed them and left a 7.9 GB prod.nc untracked.
# Match by EXTENSION anywhere in the tree so the next system is covered on
# arrival instead of after the next hang.
# (Files already committed stay tracked -- .gitignore does not untrack.)
# ---------------------------------------------------------------------------
**/*.nc
**/*.rst7
**/*.mdinfo
**/reference.frc
data/md/*/pose*/*.prmtop
data/md/*/pose*/*.inpcrd
data/md/*/pose*/*.out
data/md/*/pose*/*.in
data/md/*/pose*/*.info
data/md/*/pose*/*.log
data/md/*/pose*/*.pdb
data/md/*/pose*/*_renum.txt

# Quadruple TI systems (README 45). Extension rules above already catch the
# heavy binaries; these are the remaining per-leg build artefacts.
data/ti_quad/**/*.prmtop
data/ti_quad/**/*.inpcrd
data/ti_quad/**/*.out
data/ti_quad/**/*.in
data/ti_quad/**/*.log
data/ti_quad/**/*.pdb
data/ti_quad/**/*.parmed
data/ti_quad/**/dual.*

# Non-cognate cpptraj extraction: per-frame .dat files (15,000 rows x 12 units).
# The aggregate in results/noncognate/summary.txt is the deliverable.
results/noncognate/**/*.dat
results/noncognate/**/extract.log

# Umbrella-sampling windows (62 x ~46k-atom systems)
data/umbrella/**/*.rst7
data/umbrella/**/*.out
data/umbrella/**/*.in
data/umbrella/**/*.mdinfo
data/umbrella/**/*.rc
data/umbrella_arms/**/*.prmtop
data/umbrella_arms/**/*.inpcrd
data/umbrella_arms/**/*.pdb
data/umbrella_arms/**/*.log
data/umbrella_arms/**/*.in
data/umbrella_arms/**/*.template

# Boltz-2 co-folded sensor structures (~81 MB extracted, 682 MB archive).
# Supplied by Jannis 2026-08-27; re-extract with:
#   unzip -j boltz_predictions_719sensors.zip "*/predictions/*/*.cif" \
#            "*/predictions/*/confidence_*.json" -d boltz719/
# The DERIVED mapping and descriptors are small and ARE tracked, because
# recovering them needs the sd03/sd07/sd09 sheets and the consensus-sequence
# trick in README 80a.
data/structures/boltz719/
data/structures/*.zip
